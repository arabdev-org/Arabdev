# docker compose settings. Copy to .env and fill in.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Where people open the app. For the live site: https://arabdev.site
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# production | development (development allows the built-in dev secret)
ENVIRONMENT=production
