# Where the Vite dev server proxies /api and /media (development only).
VITE_API_PROXY=http://127.0.0.1:8000

# Production builds. Leave VITE_API_ORIGIN empty when the API is served from the same origin
# (Docker/nginx). On Cloudflare Pages set it to where the API runs, e.g. https://api.arabdev.site
VITE_API_ORIGIN=

# Documentation sites. Defaults: /wiki/, /privacy/, /patch-notes/ in development and
# https://wiki.arabdev.site/, https://privacy.arabdev.site/, https://patch.arabdev.site/ in builds.
# VITE_WIKI_URL=
# VITE_PRIVACY_URL=
# VITE_PATCH_NOTES_URL=
